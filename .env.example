# Copy to .env for local development. Set the same variables in Hostinger's
# Node.js application environment settings; never commit real credentials.
PORT=3000
NODE_ENV=development

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
SESSION_SECRET=replace-with-a-long-random-secret

GEMINI_API_KEY=replace-with-your-google-ai-studio-key
LLM_MODEL=gemini-2.5-flash

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=replace-with-mailbox-password
SMTP_SECURE=true
MAIL_FROM="DIGEGAIN <you@example.com>"
ADMIN_NOTIFY_EMAIL=you@example.com
